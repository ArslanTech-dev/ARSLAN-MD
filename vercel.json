{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": { "runtime": "nodejs20.x", "maxDuration": 60 }
    },
    {
      "src": "pair.js",
      "use": "@vercel/node",
      "config": { "runtime": "nodejs20.x", "maxDuration": 60 }
    }
  ],
  "routes": [
    {
      "src": "/pair",
      "dest": "pair.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
